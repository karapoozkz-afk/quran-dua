rules_version = '2';
// Shared repentance wall. Posts carry no author; the moderator approves them in the Firebase
// console by changing status "pending" to "approved" (or "rejected"). The console is not bound by
// these rules. The only answer under a post is one of three ready-made duas, once per person.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    match /posts/{postId} {
      allow list: if resource.data.status == 'approved';
      allow get: if resource.data.status == 'approved';

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['text', 'kind', 'lang', 'status', 'createdAt', 'd0', 'd1', 'd2'])
        && request.resource.data.status == 'pending'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.kind in ['REGRET', 'GRUDGE', 'REPENTANCE']
        && request.resource.data.lang is string
        && request.resource.data.lang.size() <= 3
        && request.resource.data.createdAt == request.time
        && request.resource.data.d0 == 0
        && request.resource.data.d1 == 0
        && request.resource.data.d2 == 0;

      // A counter goes up by exactly one, together with this person's marker doc.
      function bumped(k) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([k])
          && request.resource.data[k] == resource.data[k] + 1;
      }
      function answeredWith(n) {
        let marker = /databases/$(database)/documents/posts/$(postId)/duas/$(request.auth.uid);
        return !exists(marker) && getAfter(marker).data.kind == n;
      }
      allow update: if signedIn()
        && resource.data.status == 'approved'
        && ((bumped('d0') && answeredWith(0))
          || (bumped('d1') && answeredWith(1))
          || (bumped('d2') && answeredWith(2)));

      match /duas/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['kind'])
          && request.resource.data.kind in [0, 1, 2]
          && get(/databases/$(database)/documents/posts/$(postId)).data.status == 'approved';
      }
    }

    // Reports: one per person per post, read only in the console.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['post', 'createdAt'])
        && request.resource.data.post is string
        && reportId == request.resource.data.post + '_' + request.auth.uid
        && request.resource.data.createdAt == request.time;
    }
  }
}
