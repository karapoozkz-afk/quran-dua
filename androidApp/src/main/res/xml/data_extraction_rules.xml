<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: bookmarks, plan progress and settings move to a new phone with the user's Google backup. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="bibliya.db" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="bibliya.db" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
